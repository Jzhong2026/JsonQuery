<Window x:Class="JmesPathWpfDemo.Views.ArrayFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure Array Filter"
        Width="560"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Build a filter for array items"
                   FontWeight="Bold"
                   FontSize="16"
                   Margin="0,0,0,14"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Property" Margin="0,0,0,4"/>
                <ComboBox x:Name="PropertyComboBox"
                          SelectionChanged="InputChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Operator" Margin="0,0,0,4"/>
                <ComboBox x:Name="OperatorComboBox"
                          SelectionChanged="InputChanged"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Value" Margin="0,0,0,4"/>
                <ComboBox x:Name="ValueComboBox"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          StaysOpenOnEdit="True"
                          IsTextSearchCaseSensitive="False"
                          SelectionChanged="InputChanged"
                          LostFocus="InputChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Value Type" Margin="0,0,0,4"/>
                <ComboBox x:Name="ValueTypeComboBox"
                          SelectionChanged="InputChanged"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Text="Preview" FontWeight="Bold" Margin="0,0,0,6"/>

        <TextBox Grid.Row="4"
                 x:Name="PreviewTextBox"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 FontFamily="Consolas"
                 Background="#F5F5F5"
                 BorderBrush="#CCCCCC"
                 BorderThickness="1"
                 Padding="8"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK"
                    Width="90"
                    Margin="0,0,10,0"
                    Click="OkButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"/>
            <Button Content="Cancel"
                    Width="90"
                    Click="CancelButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>