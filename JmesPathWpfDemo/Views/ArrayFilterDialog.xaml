<Window x:Class="JmesPathWpfDemo.Views.ArrayFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate Array Filter Query"
        Width="520"
        MinHeight="300"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Select filter options"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,14"/>

        <TextBlock Grid.Row="1"
                   Text="Filter property:"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"/>

        <ComboBox Grid.Row="2"
                  x:Name="FilterPropertyComboBox"
                  Height="32"
                  FontSize="13"
                  Margin="0,0,0,12"
                  SelectionChanged="FilterPropertyComboBox_SelectionChanged"/>

        <TextBlock Grid.Row="3"
                   Text="Filter value:"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"/>

        <ComboBox Grid.Row="4"
                  x:Name="FilterValueComboBox"
                  Height="32"
                  FontSize="13"
                  Margin="0,0,0,12"/>

        <StackPanel Grid.Row="5">
            <TextBlock Text="Return property (optional):"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <ComboBox x:Name="ReturnPropertyComboBox"
                      Height="32"
                      FontSize="13"/>
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="OK"
                    Width="90"
                    Margin="0,0,10,0"
                    Click="OkButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"/>
            <Button Content="Cancel"
                    Width="90"
                    Click="CancelButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
