<Window x:Class="JmesPathWpfDemo.Views.ClientTimeZoneSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Client Timezone Settings"
        Width="560"
        Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Client timezone defaults used by todatetime when from/to timezone is not specified."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Foreground="#495057"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Client Timezone:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="ClientTimezoneComboBox" Height="28" IsEditable="True"/>
        </StackPanel>

        <CheckBox Grid.Row="2"
                  x:Name="RespectDaylightSavingsCheckBox"
                  Content="Respect daylight savings"
                  IsChecked="True"
                  Margin="0,4,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Height="32" Margin="0,0,8,0" Style="{StaticResource SuccessButtonStyle}" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="80" Height="32" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>