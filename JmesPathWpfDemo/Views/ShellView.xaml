<Window x:Class="JmesPathWpfDemo.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cal="http://caliburnmicro.com"
        Title="Query Studio" Width="1000" Height="700" WindowState="Maximized">
    <Window.Resources>
        <!-- Style for ToggleButtons that look like tabs -->
        <Style x:Key="WorkspaceToggleStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4,4,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#005A9E"/>
                    <Setter Property="BorderBrush" Value="#DEE2E6"/>
                    <Setter Property="BorderThickness" Value="1,1,1,0"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsChecked" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#E9ECEF"/>
                    <Setter Property="Foreground" Value="#212529"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header / Workspace Switcher -->
        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="10,10,10,0">
               <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right"
                            Content="Client Timezone Settings"
                            Width="180"
                            Height="32"
                            Margin="10,0,10,8"
                            Style="{StaticResource SecondaryButtonStyle}"
                            cal:Message.Attach="ConfigureClientTimeZone"/>

                    <StackPanel Orientation="Horizontal">
                <TextBlock Text="Query Studio" 
                           FontWeight="Bold" 
                           FontSize="18" 
                           Foreground="#343A40"
                           VerticalAlignment="Center"
                           Margin="10,0,30,8"/>

                <RadioButton Content="JSON Workspace (JMESPath)" 
                             IsChecked="{Binding IsJsonWorkspaceActive}"
                             Style="{StaticResource WorkspaceToggleStyle}" 
                             GroupName="WorkspaceSel"
                             Margin="0,0,5,0"/>
                
                <RadioButton Content="XML Workspace (XPath)" 
                             IsChecked="{Binding IsXmlWorkspaceActive}"
                             Style="{StaticResource WorkspaceToggleStyle}" 
                             GroupName="WorkspaceSel"/>
                   </StackPanel>
                </DockPanel>
        </Border>
        
        <!-- Active Workspace Content -->
        <ContentControl Grid.Row="1" cal:View.Model="{Binding ActiveItem}" />
    </Grid>
</Window>