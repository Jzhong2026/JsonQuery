<Window x:Class="JmesPathWpfDemo.Views.ToDateTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="To DateTime" Height="410" Width="700" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>



        <!-- Format -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Format (optional):" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FormatBox" Grid.Column="0" Height="24" FontSize="13" VerticalContentAlignment="Center" FontFamily="Consolas" ToolTip="e.g., yyyy-MM-dd HH:mm:ss" TextWrapping="NoWrap"/>
                <Button Grid.Column="1" Content="Clear" Width="55" Height="24" Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0" Click="ClearFormat_Click" ToolTip="Clear format" FontSize="12"/>
                <!-- Removed 'Fit ActiveFrom' button as requested -->
            </Grid>
        </StackPanel>

        <!-- Quick Format Options -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8" Orientation="Vertical">
            <TextBlock Text="Quick Format Options:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
            <WrapPanel Orientation="Horizontal">
                <Button Content="yyyy-MM-dd HH:mm:ss.fff" MinWidth="170" Height="24" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,4" Click="QuickFormat_Click" Tag="yyyy-MM-dd HH:mm:ss.fff" FontSize="11"/>
                <Button Content="yyyy-MM-dd HH:mm:ss" MinWidth="140" Height="24" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,4" Click="QuickFormat_Click" Tag="yyyy-MM-dd HH:mm:ss" FontSize="11"/>
                <Button Content="yyyy-MM-dd" MinWidth="100" Height="24" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,4" Click="QuickFormat_Click" Tag="yyyy-MM-dd" FontSize="11"/>
                <Button Content="MM/dd/yyyy HH:mm:ss" MinWidth="150" Height="24" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,4" Click="QuickFormat_Click" Tag="MM/dd/yyyy HH:mm:ss" FontSize="11"/>
                <Button Content="yyyyMMddTHHmmssZ" MinWidth="130" Height="24" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,4" Click="QuickFormat_Click" Tag="yyyyMMddTHHmmssZ" FontSize="11"/>
            </WrapPanel>
        </StackPanel>

        <!-- From TimeZone -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="From TimeZone:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
            <ComboBox x:Name="FromTzComboBox" Height="24" FontSize="13" IsEditable="True"/>
        </StackPanel>

        <!-- To TimeZone -->
        <StackPanel Grid.Row="4" Margin="0,0,0,4">
            <TextBlock Text="To TimeZone:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
            <ComboBox x:Name="ToTzComboBox" Height="24" FontSize="13" IsEditable="True"/>
        </StackPanel>



        <!-- Action Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Height="32" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" FontSize="13"/>
            <Button Content="Cancel" Width="80" Height="32" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
