<UserControl x:Class="JmesPathWpfDemo.Views.XmlQueryTabView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cal="http://caliburnmicro.com"
        xmlns:views="clr-namespace:JmesPathWpfDemo.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <ContextMenu x:Key="XmlNodeContextMenu" cal:Action.TargetWithoutContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Create New Tab from This Node"
                      DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      cal:Message.Attach="CreateTabFromNode($dataContext)">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="IsEnabled" Value="{Binding CanCreateTab}"/>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Generate filter Query..."
                      DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      cal:Message.Attach="GenerateArrayFilterQuery($dataContext)"
                      Visibility="{Binding IsArray, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <MenuItem Header="Clear Filter"
                      DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      cal:Message.Attach="ClearArrayFilter($dataContext)">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFilterApplied}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Generate join Query..."
                      DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      cal:Message.Attach="GenerateJoinQuery($dataContext)"
                      Visibility="{Binding IsArray, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <MenuItem Header="To DateTime..."
                      DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      cal:Message.Attach="ShowToDateTimeDialog($dataContext)"
                      Visibility="{Binding IsArray, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
            <Separator/>
            <MenuItem Header="Sort Array..."
                      DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      cal:Message.Attach="ConfigureArraySort($dataContext)"
                      Visibility="{Binding IsArray, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <MenuItem Header="Clear Sort"
                      DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      cal:Message.Attach="ClearArraySort($dataContext)"
                      Visibility="{Binding IsArray, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="XML Input:" FontSize="14" FontWeight="Normal" Foreground="#495057" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Refresh Tree" Width="100" Style="{StaticResource SuccessButtonStyle}" cal:Message.Attach="RefreshTree"/>
        </Grid>

        <TabControl Grid.Row="1" Style="{StaticResource ModernTabControlStyle}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource ModernTabItemStyle}"/>
            </TabControl.ItemContainerStyle>
            <TabItem Header="Text Input">
                <TextBox Text="{Binding XmlInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="12" Padding="5" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1"/>
            </TabItem>
            <TabItem Header="Tree View">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Padding="5" Background="#E0E0E0" TextWrapping="Wrap">
                        <Run Text="Tip: Right-click an array node to create a new tab or configure sorting"/>
                    </TextBlock>
                    <TreeView ItemsSource="{Binding XmlTreeNodes}" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="ContextMenu" Value="{StaticResource XmlNodeContextMenu}"/>
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeViewItem_PreviewMouseLeftButtonDown"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Border Padding="3,2" Cursor="Hand" Background="Transparent" cal:Message.Attach="[Event MouseDown] = [Action OnNodeSelected($dataContext)]">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#FFE699"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F0F0F0"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Foreground="#A31515" FontWeight="SemiBold"/>
                                        <TextBlock Text=": " Foreground="Black" Visibility="{Binding HasValue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Value}" Foreground="#0451A5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsArrayNode}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text=": " Foreground="Black" Visibility="{Binding IsArrayNode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding ValueText}" Foreground="#333333" Visibility="{Binding IsArrayNode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="XPath Query:" FontSize="14" FontWeight="Normal" Foreground="#495057" Margin="0,10,0,5"/>
        <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Execute" Width="100" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" cal:Message.Attach="Execute"/>
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="5" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1"/>
        </DockPanel>

        <Grid Grid.Row="4" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Result:" FontSize="14" FontWeight="Normal" Foreground="#495057" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Create Tab from Result" Width="160" Height="28" Style="{StaticResource PurpleButtonStyle}" Visibility="{Binding HasValidResult, Converter={StaticResource BooleanToVisibilityConverter}}" cal:Message.Attach="CreateTabFromResult"/>
        </Grid>

        <TextBox Grid.Row="5" Text="{Binding Result, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontSize="12" FontFamily="Consolas" Padding="5" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1"/>
    </Grid>
</UserControl>