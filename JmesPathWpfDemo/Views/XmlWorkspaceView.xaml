<UserControl x:Class="JmesPathWpfDemo.Views.XmlWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://caliburnmicro.com">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,0,0,15">
            <Button Content="XML Query" 
                    Width="120"
                    Margin="0,0,5,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Setter Property="Background" Value="#005A9E"/>
                    </Style>
                </Button.Style>
            </Button>
            
            <Button Content="XPath Function Reference" 
                    Width="180"
                    Margin="5,0,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"/>
                </Button.Style>
            </Button>
        </StackPanel>

        <Grid Grid.Row="1">
            <TextBlock Text="XML / XPath Tools Coming Soon..." 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="24" 
                       Foreground="Gray"/>
        </Grid>
    </Grid>
</UserControl>