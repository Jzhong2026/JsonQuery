<UserControl x:Class="JmesPathWpfDemo.Views.XmlWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://caliburnmicro.com">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <ContextMenu x:Key="XmlNodeContextMenu" 
                     cal:Action.TargetWithoutContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Generate filter Query..."
                      DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      cal:Message.Attach="GenerateArrayFilterQuery($dataContext)">
            </MenuItem>
            <MenuItem Header="Generate map Query..."
                      DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      cal:Message.Attach="GenerateMapQuery($dataContext)">
            </MenuItem>
            <MenuItem Header="Generate join Query..."
                      DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      cal:Message.Attach="GenerateJoinQuery($dataContext)">
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,0,0,15">
            <Button Content="XML Query" 
                    Width="120"
                    Margin="0,0,5,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Setter Property="Background" Value="#005A9E"/>
                    </Style>
                </Button.Style>
            </Button>
            
            <Button Content="XPath Function Reference" 
                    Width="180"
                    Margin="5,0,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"/>
                </Button.Style>
            </Button>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title and Buttons Section -->
            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="XML Input:" 
                           FontSize="14"
                           FontWeight="Normal"
                           Foreground="#495057"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="Refresh Tree" 
                        Width="100"
                        Style="{StaticResource SuccessButtonStyle}"
                        cal:Message.Attach="RefreshTree"/>
            </Grid>

            <TabControl Grid.Row="1" Style="{StaticResource ModernTabControlStyle}">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource ModernTabItemStyle}"/>
                </TabControl.ItemContainerStyle>
                <!-- Text Input Tab -->
                <TabItem Header="Text Input">
                    <TextBox Text="{Binding XmlInput, UpdateSourceTrigger=PropertyChanged}" 
                             AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto"
                             FontSize="12"
                             Padding="5"
                             Background="#F5F5F5"
                             BorderBrush="#CCCCCC"
                             BorderThickness="1"/>
                </TabItem>

                <!-- Tree View Tab -->
                <TabItem Header="Tree View">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" 
                                   Padding="5"
                                   Background="#E0E0E0"
                                   TextWrapping="Wrap">
                            <Run Text="Tip: Select any node to generate its XPath"/>
                        </TextBlock>
                        <TreeView ItemsSource="{Binding XmlTreeNodes}" 
                                  Background="#F5F5F5"
                                  BorderBrush="#CCCCCC"
                                  BorderThickness="1">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="ContextMenu" Value="{StaticResource XmlNodeContextMenu}"/>
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeViewItem_PreviewMouseLeftButtonDown"/>
                                    <!-- Use Tag or direct Event binding in view behind if needed. In MVVM we can use Caliburn attached event or code behind. -->
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <!-- XmlTreeNode template -->
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Border Padding="3,2" Cursor="Hand" Background="Transparent" cal:Message.Attach="[Event MouseDown] = [Action OnNodeSelected($dataContext)]">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#FFE699"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F0F0F0"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Node Name -->
                                            <TextBlock Text="{Binding Name}" Foreground="#A31515" FontWeight="SemiBold"/>
                                            <TextBlock Text=": " Foreground="Black" Visibility="{Binding HasValue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <!-- Node Value -->
                                            <TextBlock Text="{Binding Value}" Foreground="#0451A5"/>
                                            <!-- Additional Attributes visual element if we expand them -->
                                        </StackPanel>
                                    </Border>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <!-- Query Section -->
            <TextBlock Grid.Row="2" Text="XPath Query:" FontSize="14" FontWeight="Normal" Foreground="#495057" Margin="0,10,0,5"/>
            <DockPanel Grid.Row="3" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right"
                        Content="Execute" 
                        Width="100"
                        Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        cal:Message.Attach="Execute"/>
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="12"
                         Padding="5"
                         Height="60"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="#F5F5F5"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"/>
            </DockPanel>

            <!-- Result Section -->
            <Grid Grid.Row="4" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Result:" FontSize="14" FontWeight="Normal" Foreground="#495057" VerticalAlignment="Center"/>
            </Grid>

            <TextBox Grid.Row="5"
                     Text="{Binding Result, Mode=OneWay}" 
                     IsReadOnly="True" 
                     AcceptsReturn="True" 
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontSize="12"
                     FontFamily="Consolas"
                     Padding="5"
                     Background="#FAFAFA"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"/>
        </Grid>
    </Grid>
</UserControl>